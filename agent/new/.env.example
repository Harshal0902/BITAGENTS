# Solana DCA Agent — copy to .env and fill in values
#   cp .env.example .env

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1

# ─── Solana network ───────────────────────────────────────────────────────────
# devnet: scheduled SOL transfers (Jupiter unavailable)
# mainnet: real Jupiter token swaps
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# For mainnet Jupiter swaps, use e.g.:
# SOLANA_CLUSTER=mainnet-beta
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ─── Wallet (required for live transactions) ────────────────────────────────
# Base58 secret key OR JSON byte array from `solana-keygen new --outfile key.json`
# Never commit this file with a real key.
DCA_WALLET_PRIVATE_KEY=

# Optional alias (used if DCA_WALLET_PRIVATE_KEY is empty)
# SOLANA_PRIVATE_KEY=

# ─── Agent options ────────────────────────────────────────────────────────────
# How often the background scheduler checks for due DCA buys (seconds)
DCA_SCHEDULER_POLL_SECONDS=30

# Optional custom path for persisted DCA plans JSON
# DCA_PLANS_FILE=./dca_plans.json

# Optional custom path for verified user deposit ledger JSON
# DCA_DEPOSITS_FILE=./user_deposits.json

# ─── Local HTTP API (frontend integration) ────────────────────────────────────
# Run: python dca_api.py
DCA_API_HOST=127.0.0.1
DCA_API_PORT=8765

# Jupiter API endpoints (defaults are fine for most users)
# JUPITER_QUOTE_API=https://quote-api.jup.ag/v6/quote
# JUPITER_SWAP_API=https://quote-api.jup.ag/v6/swap
