# BIT Agents Python API (run: cd agent/new && python agents_api.py)
AGENTS_API_URL=http://127.0.0.1:8765
# AGENTS_API_URL=https://your-render-service.onrender.com

# Must match agent/new/.env - blocks direct access to the Python API
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTS_INTERNAL_API_KEY=

# Solana - private RPC stays server-side (proxied at /api/solana/rpc for wallet UI)
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Used in wallet sign-in message legal URLs (defaults to https://bitagents.io)
# NEXT_PUBLIC_APP_URL=https://your-frontend-domain.com
